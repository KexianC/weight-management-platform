{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"], "allowJs": true, "checkJs": false,
    "skipLibCheck": true, "noEmit": true, "strict": false,
    "types": ["@dcloudio/types", "vite/client"]
  },
  "include": ["src/**/*.vue", "src/**/*.js", "src/**/*.d.ts"],
  "exclude": ["src/**/*.test.mjs", "node_modules", "dist", ".typecheck-tools"]
}
