NODE_ENV=production
RELEASE_TAG=2026.10.28-1
DATABASE_URL=mysql://weightcare:replace-with-url-encoded-rds-password@replace-with-rds-private-host:3306/weightcare
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=weight-care-api
JWT_AUDIENCE=weight-care-clients
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
SMS_CODE_PEPPER=replace-with-another-32-character-random-secret
SMS_CODE_TTL_SECONDS=300
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIYUN_SMS_ENDPOINT=dysmsapi.aliyuncs.com
ALIYUN_SMS_REGION_ID=cn-hangzhou
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
# Configure your own approved follow-up template; empty disables direct reminder SMS.
ALIYUN_SMS_FOLLOWUP_TEMPLATE_CODE=
# Only custom template codes need an explicit JSON variable mapping (practitionerName/scheduledTime/content/date/patientName).
ALIYUN_SMS_FOLLOWUP_TEMPLATE_PARAMS=
# Optional rollout activation instant (ISO 8601), e.g. next scheduled 20:00 Asia/Shanghai.
YUANQIZHAN_REMINDERS_NOT_BEFORE=
SMS_DELIVERY_WEBHOOK_URL=
SMS_DELIVERY_WEBHOOK_TOKEN=
REMINDER_CRON_SECRET=replace-with-a-fourth-32-character-random-secret
REMINDER_DELIVERY_WEBHOOK_URL=
REMINDER_DELIVERY_WEBHOOK_TOKEN=
WECHAT_MINI_APP_ID=
WECHAT_MINI_APP_SECRET=
PRACTITIONER_REGISTRATION_CODES=replace-with-one-or-more-comma-separated-clinician-codes
CORS_ORIGINS=https://weight.example.com
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=replace-with-private-oss-bucket
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
API_PUBLIC_URL=https://weight.example.com
MEDIA_SIGNING_SECRET=replace-with-a-third-32-character-random-secret
MEDIA_LOCAL_DIR=./uploads
SEED_DEMO_PASSWORD=change-this-local-demo-password
ALLOW_DEMO_SEED=false
DEFAULT_ADMIN_USERNAME=
DEFAULT_ADMIN_PASSWORD=
VITE_API_BASE_URL=https://weight.example.com/api/v1
VITE_STORAGE_BASE_URL=https://weight.example.com

# Patient H5 URL used by invites and shared reports; use your own domain.
PATIENT_APP_URL=https://weight.example.com/h5/
# Third-party deployment defaults; external OCR stays disabled until configured.
API_BIND_ADDRESS=0.0.0.0
RECONSTRUCTION_LOCAL_ONLY=false
OCR_PROVIDER=disabled
OCR_MOCK_ENABLED=false
